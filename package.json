{
  "name": "vue3-tailwind-components",
  "version": "1.0.0",
  "description": "A library of Vue 3 components that use Tailwind",
  "keywords": [
    "vue3",
    "tailwind",
    "components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardhulbert/vue3-tailwind-components.git"
  },
  "files": [
    "dist",
    "plugin"
  ],
  "main": "./dist/vue3-tailwind-components.umd.js",
  "module": "./dist/vue3-tailwind-components.es.js",
  "exports": {
    ".": {
      "import": "./dist/vue3-tailwind-components.es.js",
      "require": "./dist/vue3-tailwind-components.umd.js"
    },
    "./tailwind": "./plugin/tailwind.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build --config site.config.js --outDir .preview --emptyOutDir && vite preview --config site.config.js --outDir .preview",
    "site": "vite build --config site.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.2.1",
    "@fortawesome/free-brands-svg-icons": "^6.2.1",
    "@fortawesome/free-regular-svg-icons": "^6.2.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.1",
    "@fortawesome/vue-fontawesome": "^3.0.2",
    "@vueuse/core": "^13.7.0",
    "click-outside-vue3": "^4.0.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.13",
    "happy-dom": "^21.0.4",
    "postcss": "^8.4.20",
    "tailwindcss": "^3.2.4",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue": "^3.5.45"
  }
}
